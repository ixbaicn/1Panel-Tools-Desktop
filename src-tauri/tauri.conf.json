{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1Panel Tools Desktop",
  "version": "0.3.0",
  "identifier": "com.onepanel.toolsdesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "1Panel Tools Desktop",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/favicon-32x32.png",
      "../public/android-chrome-192x192.png",
      "../public/android-chrome-512x512.png",
      "../public/favicon.ico"
    ]
  }
}
